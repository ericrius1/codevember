{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true, "noEmit": true, "allowJs": false, "skipLibCheck": true, "allowArbitraryExtensions": true, "isolatedModules": true,
    "types": ["@webgpu/types", "vite/client", "@ericrius1/weft/client"]
  },
  "include": ["src", "0*/**/*", "1*/**/*", "2*/**/*", "3*/**/*"],
  "exclude": ["node_modules", "dist", "deploy", "*/audio", "*/lab"]
}
